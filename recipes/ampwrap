
{% set name = "ampwrap" %}
{% set version = "0.1.0" %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  https://github.com/LDoni/AmpWrap/archive/v{{ version }}.tar.gz
  sha256: df2c56c96e4f541676ced547327265f8f9db06ddd348db581d54e707ca1104bc
  
build:
  noarch: python
  number: 0
  script:
    - install -d ${PREFIX}/lib/python3.9/site-packages/ampwrap/
    - install -m 755 AmpWrap_long AmpWrap_short ${PREFIX}/lib/python3.9/site-packages/ampwrap/
    - {{ PYTHON }} -m pip install . -vv
  entry_points:
    - ampwrap = ampwrap.cli:main
    - ampwrap-long = ampwrap.cli:long
    - ampwrap-short = ampwrap.cli:short
requirements:
  host:
    - python >= 3.8
    - pip
    - setuptools
  run:
    - python >=3.8
    - python-click >=8.0
    - snakemake >=7.0
    - click >=8.0
    - cutadapt >=3.0
    - nanofilt
    - multiqc
    - fastqc >=0.11
    - porechop
    - porechop_abi
    - bioconductor-dada2 >=1.20
    - bioconductor-decipher >=2.20
    - emu
    - ca-certificates
    - openssl

test:
  commands:
    - ampwrap --help
    - ampwrap-long --help
    - ampwrap-short --help
    - pip check
  imports:
    - ampwrap

about:
  home: https://github.com/LDoni/AmpWrap
  license: MIT
  license_family: MIT
  license_file: LICENSE
  summary: 'Comprehensive pipeline for amplicon sequence analysis'
  description: |
    AmpWrap provides automated processing of both short and long-read
    amplicon sequencing data through a Snakemake pipeline with quality
    control, trimming, and taxonomic classification.
  doc_url: https://github.com/LDoni/AmpWrap#readme
  dev_url: https://github.com/LDoni/AmpWrap


extra:
  recipe-maintainers:
    - LDoni
